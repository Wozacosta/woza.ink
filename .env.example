# Laterlist integration (reading page)
LATERLIST_API_KEY=ll_your_api_key_here
# Optional, this is the default
LATERLIST_API_URL=https://www.laterlist.cc

# On-demand revalidation (pnpm sync)
REVALIDATE_SECRET=your_secret_here

# Private /stats dashboard (Basic auth password, Vercel token with access to the team)
STATS_PASSWORD=choose_a_password
VERCEL_STATS_TOKEN=your_vercel_token
VERCEL_TEAM_ID=team_xxx
