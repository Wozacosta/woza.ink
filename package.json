{
  "name": "woza.ink",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "screenshots": "node scripts/capture-project-screenshots.ts",
    "sync": "set -a && . ./.env && set +a && curl -s -X POST -H \"x-revalidate-secret: ${REVALIDATE_SECRET}\" \"https://www.woza.ink/api/revalidate?path=/reading\""
  },
  "dependencies": {
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@vercel/analytics": "^1.6.1",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.1",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^4.0.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-istanbul": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.4",
    "happy-dom": "^20.3.7",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.12.0",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2"
}
